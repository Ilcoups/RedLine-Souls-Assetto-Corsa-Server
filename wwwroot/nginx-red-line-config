server {
    listen 80;
    server_name red-line.live www.red-line.live;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name red-line.live www.red-line.live;
    
    ssl_certificate /etc/letsencrypt/live/red-line.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/red-line.live/privkey.pem;
    
    root /home/acserver/server/wwwroot;
    index index.html;
    
    location / {
        try_files $uri $uri/ =404;
    }
}
