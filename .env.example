# RedLine Souls - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Discord Webhooks
# Main events webhook (player joins/leaves with session summaries)
DISCORD_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Chat/announcements webhook (for chat-like messages)
DISCORD_CHAT_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Statistics webhook (daily leaderboards and stats)
DISCORD_STATS_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# UDP Plugin Configuration (for chat messages)
# Should match the UDP_PLUGIN_ADDRESS in cfg/extra_cfg.yml
UDP_PLUGIN_HOST=127.0.0.1
UDP_PLUGIN_PORT=12001

# Optional: Additional configuration
# LOG_LEVEL=INFO
# CHECK_INTERVAL=0.5
